{
  "sourceLanguage" : "en",
  "strings" : {
    "Pico could not decrypt this notice. Open Settings → Remote Hosts → %@ → Notifications and tap Send to This iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico konnte diese Mitteilung nicht entschlüsseln. Öffne Einstellungen → Remote-Hosts → %@ → Mitteilungen und tippe auf An dieses iPhone senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico could not decrypt this notice. Open Settings → Remote Hosts → %@ → Notifications and tap Send to This iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico no pudo descifrar este aviso. Abre Ajustes → Hosts remotos → %@ → Notificaciones y toca Enviar a este iPhone."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na-decrypt ng Pico ang abisong ito. Buksan ang Settings → Remote Hosts → %@ → Notifications at i-tap ang Ipadala sa iPhone na Ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico n’a pas pu déchiffrer cette notification. Ouvrez Réglages → Hôtes distants → %@ → Notifications et touchez Envoyer à cet iPhone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico nije mogao dešifrirati ovu obavijest. Otvorite Postavke → Udaljeni hostovi → %@ → Obavijesti i dodirnite Pošalji na ovaj iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico tidak bisa mendekripsi notifikasi ini. Buka Pengaturan → Remote Hosts → %@ → Notifikasi dan ketuk Kirim ke iPhone Ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico はこの通知を復号できませんでした。「設定」→ リモートホスト → %@ →「通知」を開き、「このiPhoneに送信」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico가 이 알림을 복호화하지 못했습니다. 설정 → 원격 호스트 → %@ → 알림을 열고 이 iPhone으로 보내기를 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico tidak dapat menyahsulit notis ini. Buka Tetapan → Remote Hosts → %@ → Notis dan ketik Hantar ke iPhone Ini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico nie mógł odszyfrować tego powiadomienia. Otwórz Ustawienia → Zdalne hosty → %@ → Powiadomienia i stuknij Wyślij na ten iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pico não conseguiu descriptografar este aviso. Abra Ajustes → Hosts remotos → %@ → Notificações e toque em Enviar para este iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico nu a putut decripta această notificare. Deschideți Setări → Hosturi la distanță → %@ → Notificări și atingeți Trimite pe acest iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico не смог расшифровать это уведомление. Откройте «Настройки» → «Удалённые хосты» → %@ → «Уведомления» и нажмите «Отправить на этот iPhone»."
          }
        },
        "th" : {
          "stringUnit" : {
