        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico bu bildirimin şifresini çözemedi. Ayarlar → Uzak Hostlar → %@ → Bildirimler bölümünü açıp Bu iPhone'a Gönder'e dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico 无法解密此通知。请打开“设置”→“远程主机”→ %@ →“通知”，然后轻点“发送到此 iPhone”。"
          }
